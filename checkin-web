<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>运动每日打卡</title>
<style>
  :root {
    --bg: #f5f5f2;
    --card: #ffffff;
    --text: #1a1a18;
    --text-secondary: #6b6b66;
    --text-muted: #9a9a94;
    --border: #e6e5df;
    --accent: #3a7afe;
    --accent-bg: #e8f0ff;
    --success: #2f9e5e;
    --success-bg: #e6f6ec;
    --radius: 14px;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #app {
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 16px 16px 88px;
  }
  h1 {
    font-size: 18px;
    font-weight: 600;
    margin: 4px 0 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 14px;
  }
  .streak-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 4px;
    text-align: center;
  }
  .streak-num {
    font-size: 30px;
    font-weight: 600;
    margin: 0 0 12px;
    text-align: center;
  }
  button.checkin {
    width: 100%;
    border: none;
    border-radius: 10px;
    padding: 13px;
    font-size: 15px;
    font-weight: 600;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  button.checkin.done {
    background: var(--success);
  }
  button.checkin:active {
    transform: scale(0.98);
  }
  .cal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .cal-header span { font-size: 15px; font-weight: 600; }
  .cal-header button {
    border: none;
    background: none;
    font-size: 18px;
    color: var(--text-secondary);
    padding: 4px 10px;
  }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    text-align: center;
  }
  .cal-grid .wd {
    font-size: 11px;
    color: var(--text-muted);
    padding-bottom: 4px;
  }
  .cal-grid .day {
    font-size: 13px;
    padding: 8px 0;
    border-radius: 50%;
    color: var(--text);
    position: relative;
  }
  .cal-grid .day.checked {
    background: var(--success-bg);
    color: var(--success);
    font-weight: 600;
  }
  .cal-grid .day.today {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .legend {
    display: flex;
    gap: 14px;
    margin-top: 10px;
    font-size: 11px;
    color: var(--text-muted);
    align-items: center;
  }
  .legend .dot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }
  .dot.on { background: var(--success); }
  .dot.off { border: 1.5px solid var(--text-muted); }

  .range-row {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }
  .range-row button {
    flex: 1;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 14px;
    color: var(--text);
  }
  .range-row button.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-bg);
    font-weight: 600;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
  }
  .stat-card .label {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0 0 6px;
  }
  .stat-card .value {
    font-size: 22px;
    font-weight: 600;
    margin: 0;
  }
  .chart-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 12px;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 110px;
  }
  .bars .bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    gap: 4px;
  }
  .bars .bar {
    width: 100%;
    max-width: 22px;
    background: var(--accent);
    border-radius: 4px 4px 0 0;
    min-height: 2px;
  }
  .bars .bar-tick {
    font-size: 9px;
    color: var(--text-muted);
  }

  .tabbar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: center;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  .tabbar-inner {
    max-width: 480px;
    width: 100%;
    display: flex;
  }
  .tab-btn {
    flex: 1;
    background: none;
    border: none;
    padding: 10px 0 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: var(--text-muted);
    font-size: 11px;
  }
  .tab-btn.active { color: var(--accent); }
  .tab-btn svg { width: 22px; height: 22px; }
  .page { display: none; }
  .page.active { display: block; }
</style>
</head>
<body>
<div id="app">
  <h1>每日打卡</h1>

  <div id="page-calendar" class="page active">
    <div class="card">
      <p class="streak-label">连续打卡</p>
      <p class="streak-num" id="streak-num">0 天</p>
      <button class="checkin" id="checkin-btn">今日签到</button>
    </div>

    <div class="card">
      <div class="cal-header">
        <button id="prev-month" aria-label="上个月">‹</button>
        <span id="month-title">2026年7月</span>
        <button id="next-month" aria-label="下个月">›</button>
      </div>
      <div class="cal-grid" id="cal-grid"></div>
      <div class="legend">
        <span><span class="dot on"></span>已打卡</span>
        <span><span class="dot off"></span>未打卡</span>
      </div>
    </div>
  </div>

  <div id="page-stats" class="page">
    <div class="range-row">
      <button data-range="month" class="active">月</button>
      <button data-range="quarter">季</button>
      <button data-range="year">年</button>
    </div>
    <div class="stat-grid">
      <div class="stat-card">
        <p class="label">打卡天数</p>
        <p class="value" id="stat-days">0</p>
      </div>
      <div class="stat-card">
        <p class="label">打卡率</p>
        <p class="value" id="stat-rate">0%</p>
      </div>
      <div class="stat-card">
        <p class="label">最长连续</p>
        <p class="value" id="stat-streak">0 天</p>
      </div>
      <div class="stat-card">
        <p class="label">断卡次数</p>
        <p class="value" id="stat-miss">0</p>
      </div>
    </div>
    <div class="card">
      <p class="chart-label" id="chart-label">近30天打卡情况</p>
      <div class="bars" id="bars"></div>
    </div>
  </div>
</div>

<div class="tabbar">
  <div class="tabbar-inner">
    <button class="tab-btn active" data-page="calendar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
      日历
    </button>
    <button class="tab-btn" data-page="stats">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
      统计
    </button>
  </div>
</div>

<script>
(function () {
  var STORAGE_KEY = 'checkin_records_v1';

  function loadRecords() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }
  function saveRecords(arr) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
  }
  function toKey(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }
  function startOfDay(d) {
    var n = new Date(d);
    n.setHours(0,0,0,0);
    return n;
  }
  function addDays(d, n) {
    var r = new Date(d);
    r.setDate(r.getDate() + n);
    return r;
  }
  function addMonths(d, n) {
    var r = new Date(d);
    r.setMonth(r.getMonth() + n);
    return r;
  }

  var records = new Set(loadRecords());
  var today = startOfDay(new Date());
  var displayedMonth = new Date(today.getFullYear(), today.getMonth(), 1);

  function isChecked(d) { return records.has(toKey(d)); }
  function toggleToday() {
    var key = toKey(today);
    if (records.has(key)) records.delete(key); else records.add(key);
    saveRecords(Array.from(records));
    renderCheckinCard();
    renderCalendar();
    renderStats();
  }
  function toggleDay(d) {
    var key = toKey(d);
    if (records.has(key)) records.delete(key); else records.add(key);
    saveRecords(Array.from(records));
    renderCalendar();
    renderCheckinCard();
    renderStats();
  }

  function currentStreak() {
    var streak = 0;
    var cursor = new Date(today);
    while (records.has(toKey(cursor))) {
      streak++;
      cursor = addDays(cursor, -1);
    }
    return streak;
  }
  function longestStreak() {
    var days = Array.from(records).sort();
    if (!days.length) return 0;
    var longest = 1, current = 1;
    for (var i = 1; i < days.length; i++) {
      var prev = new Date(days[i-1]);
      var cur = new Date(days[i]);
      var diff = Math.round((cur - prev) / 86400000);
      if (diff === 1) { current++; longest = Math.max(longest, current); }
      else if (diff !== 0) { current = 1; }
    }
    return longest;
  }

  function renderCheckinCard() {
    document.getElementById('streak-num').textContent = currentStreak() + ' 天';
    var btn = document.getElementById('checkin-btn');
    var done = isChecked(today);
    btn.textContent = done ? '已签到' : '今日签到';
    btn.classList.toggle('done', done);
  }

  function renderCalendar() {
    var grid = document.getElementById('cal-grid');
    grid.innerHTML = '';
    var wd = ['日','一','二','三','四','五','六'];
    wd.forEach(function (w) {
      var el = document.createElement('div');
      el.className = 'wd';
      el.textContent = w;
      grid.appendChild(el);
    });
    document.getElementById('month-title').textContent =
      displayedMonth.getFullYear() + '年' + (displayedMonth.getMonth() + 1) + '月';

    var firstWeekday = displayedMonth.getDay();
    var daysInMonth = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth() + 1, 0).getDate();

    for (var i = 0; i < firstWeekday; i++) {
      grid.appendChild(document.createElement('div'));
    }
    for (var day = 1; day <= daysInMonth; day++) {
      var d = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth(), day);
      var cell = document.createElement('div');
      cell.className = 'day';
      if (isChecked(d)) cell.classList.add('checked');
      if (startOfDay(d).getTime() === today.getTime()) cell.classList.add('today');
      cell.textContent = day;
      cell.addEventListener('click', function (dd) {
        return function () { toggleDay(dd); };
      }(d));
      grid.appendChild(cell);
    }
  }

  function monthInterval(ref) {
    var start = new Date(ref.getFullYear(), ref.getMonth(), 1);
    var end = new Date(ref.getFullYear(), ref.getMonth() + 1, 1);
    return { start: start, end: end };
  }
  function quarterInterval(ref) {
    var qStartMonth = Math.floor(ref.getMonth() / 3) * 3;
    var start = new Date(ref.getFullYear(), qStartMonth, 1);
    var end = new Date(ref.getFullYear(), qStartMonth + 3, 1);
    return { start: start, end: end };
  }
  function yearInterval(ref) {
    var start = new Date(ref.getFullYear(), 0, 1);
    var end = new Date(ref.getFullYear() + 1, 0, 1);
    return { start: start, end: end };
  }
  function countChecked(start, end) {
    var count = 0;
    var cursor = new Date(start);
    while (cursor < end) {
      if (isChecked(cursor)) count++;
      cursor = addDays(cursor, 1);
    }
    return count;
  }
  function daysBetween(start, end) {
    return Math.round((end - start) / 86400000);
  }

  var currentRange = 'month';

  function computeStats(range) {
    var ref = today;
    var full;
    if (range === 'month') full = monthInterval(ref);
    else if (range === 'quarter') full = quarterInterval(ref);
    else full = yearInterval(ref);

    var effectiveEnd = full.end < addDays(today, 1) ? full.end : addDays(today, 1);
    var totalDays = Math.max(daysBetween(full.start, effectiveEnd), 0);
    var checkedCount = countChecked(full.start, effectiveEnd);
    var missed = Math.max(totalDays - checkedCount, 0);
    var rate = totalDays > 0 ? checkedCount / totalDays : 0;

    var buckets = [];
    if (range === 'month') {
      var cursor = new Date(full.start);
      var weekIdx = 1;
      while (cursor < full.end) {
        var next = addDays(cursor, 7);
        if (next > full.end) next = full.end;
        var bEnd = next < effectiveEnd ? next : effectiveEnd;
        var bDays = daysBetween(cursor, bEnd);
        var bChecked = bDays > 0 ? countChecked(cursor, bEnd) : 0;
        buckets.push({ label: '第' + weekIdx + '周', rate: bDays > 0 ? bChecked / bDays : 0 });
        cursor = next;
        weekIdx++;
      }
    } else {
      var cursor2 = new Date(full.start);
      while (cursor2 < full.end) {
        var next2 = addMonths(cursor2, 1);
        var bEnd2 = next2 < effectiveEnd ? next2 : effectiveEnd;
        var bDays2 = daysBetween(cursor2, bEnd2);
        var bChecked2 = bDays2 > 0 ? countChecked(cursor2, bEnd2) : 0;
        buckets.push({ label: (cursor2.getMonth() + 1) + '月', rate: bDays2 > 0 ? bChecked2 / bDays2 : 0 });
        cursor2 = next2;
      }
    }

    return { checkedCount: checkedCount, totalDays: totalDays, rate: rate, missed: missed, buckets: buckets };
  }

  function renderStats() {
    var s = computeStats(currentRange);
    document.getElementById('stat-days').textContent = s.checkedCount;
    document.getElementById('stat-rate').textContent = Math.round(s.rate * 100) + '%';
    document.getElementById('stat-streak').textContent = longestStreak() + ' 天';
    document.getElementById('stat-miss').textContent = s.missed;
    var labels = { month: '本月各周打卡率', quarter: '本季度各月打卡率', year: '本年各月打卡率' };
    document.getElementById('chart-label').textContent = labels[currentRange];

    var bars = document.getElementById('bars');
    bars.innerHTML = '';
    s.buckets.forEach(function (b) {
      var wrap = document.createElement('div');
      wrap.className = 'bar-wrap';
      var bar = document.createElement('div');
      bar.className = 'bar';
      bar.style.height = Math.max(Math.round(b.rate * 100), 2) + '%';
      var tick = document.createElement('div');
      tick.className = 'bar-tick';
      tick.textContent = b.label;
      wrap.appendChild(bar);
      wrap.appendChild(tick);
      bars.appendChild(wrap);
    });
  }

  document.getElementById('checkin-btn').addEventListener('click', toggleToday);
  document.getElementById('prev-month').addEventListener('click', function () {
    displayedMonth = addMonths(displayedMonth, -1);
    renderCalendar();
  });
  document.getElementById('next-month').addEventListener('click', function () {
    displayedMonth = addMonths(displayedMonth, 1);
    renderCalendar();
  });

  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var page = btn.getAttribute('data-page');
      document.getElementById('page-calendar').classList.toggle('active', page === 'calendar');
      document.getElementById('page-stats').classList.toggle('active', page === 'stats');
    });
  });

  document.querySelectorAll('.range-row button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.range-row button').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      currentRange = btn.getAttribute('data-range');
      renderStats();
    });
  });

  renderCheckinCard();
  renderCalendar();
  renderStats();
})();
</script>
</body>
</html>
